<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exchange-rate cache and device-local URI are excluded. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="calculator.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="calculator.xml" />
    </device-transfer>
</data-extraction-rules>
